# =====================
# Docker Compose Prod
# =====================

COMPOSE_PROJECT_NAME=edusmart-prod

# Public URL (gunakan domain asli + HTTPS)
APP_URL=https://edusmart.example.com
FRONTEND_URL=https://edusmart.example.com
# Port publik HTTP sekarang diexpose oleh Caddy (bukan langsung Nginx).
NGINX_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_HTTPS_PORT_SUFFIX=
CADDY_ACME_EMAIL=ops@edusmart.example.com
CADDY_ASK_SECRET=CHANGE_ME_CADDY_ASK_SECRET
CADDY_EVOLUTION_HOST=wa.edusmart.example.com
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# Frontend build-time API target
# Kosongkan untuk mode 1 VPS: frontend akan otomatis memanggil host yang sama.
VITE_API_URL=
VITE_TENANT_SLUG=
VITE_ROOT_DOMAIN=edusmart.example.com
VITE_ADMIN_SUBDOMAIN=admin
VITE_REALTIME_POLL_MS=4000
VITE_REALTIME_POLL_HIDDEN_MS=12000
VITE_GOOGLE_AUTH_ENABLED=false
# Gunakan path relatif agar otomatis mengikuti subdomain tenant aktif.
VITE_GOOGLE_AUTH_LOGIN_URL=/api/auth/google/redirect
VITE_GOOGLE_AUTH_LINK_URL=/api/auth/google/link

# Laravel app key
# Generate: docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
APP_KEY=base64:CHANGE_ME

# PostgreSQL
DB_DATABASE=edusmart
DB_USERNAME=edusmart
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Mail (Brevo SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_BREVO_LOGIN
MAIL_PASSWORD=CHANGE_ME_BREVO_SMTP_KEY
MAIL_FROM_ADDRESS=no-reply@edusmart.example.com
MAIL_FROM_NAME="EduSmart"
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domain callback ini WAJIB didaftarkan di Google Cloud Console (Authorized redirect URI).
GOOGLE_REDIRECT_URI=https://edusmart.example.com/api/auth/google/callback
GOOGLE_AUTH_PROMPT=select_account

# Evolution API (1 VPS, multi-container)
EVOLUTION_API_IMAGE=atendai/evolution-api:v2.1.1
EVOLUTION_PUBLIC_URL=https://wa.edusmart.example.com
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_API_KEY
EVOLUTION_API_BASE_URL=http://evolution_api:8080
EVOLUTION_API_INTEGRATION=WHATSAPP-BAILEYS
EVOLUTION_API_INSTANCE_PREFIX=edusmart
EVOLUTION_API_WEBHOOK_BASE_URL=https://edusmart.example.com
EVOLUTION_API_TIMEOUT_SECONDS=20
EVOLUTION_API_VERIFY_SSL=true
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=CHANGE_ME_EVOLUTION_DB_PASSWORD
EVOLUTION_DB_CLIENT_NAME=edusmart_evolution
EVOLUTION_REDIS_PASSWORD=CHANGE_ME_EVOLUTION_REDIS_PASSWORD
EVOLUTION_LOG_LEVEL=ERROR,WARN,INFO
EVOLUTION_TELEMETRY=false
EVOLUTION_CORS_ORIGIN=*
EVOLUTION_SAVE_NEW_MESSAGE=false
EVOLUTION_SAVE_MESSAGE_UPDATE=false

# RFID / MQTT Bridge
RFID_SCAN_SHARED_KEY=CHANGE_ME_RFID_SHARED_KEY
RFID_MQTT_BRIDGE_ENABLED=true
RFID_MQTT_HOST=YOUR_HIVEMQ_HOST
RFID_MQTT_PORT=8883
RFID_MQTT_USERNAME=YOUR_HIVEMQ_USERNAME
RFID_MQTT_PASSWORD=YOUR_HIVEMQ_PASSWORD
RFID_MQTT_CLIENT_ID_PREFIX=edusmart-rfid-bridge
RFID_MQTT_QOS=1
RFID_MQTT_USE_TLS=true
RFID_MQTT_TLS_VERIFY_PEER=true
RFID_MQTT_TLS_VERIFY_PEER_NAME=true
RFID_MQTT_TLS_ALLOW_SELF_SIGNED=false
RFID_MQTT_SCAN_TOPIC_TEMPLATE=edusmart/{tenant}/rfid/scan
RFID_MQTT_SCAN_TOPIC_FILTER=
RFID_MQTT_RESPONSE_TOPIC_TEMPLATE=edusmart/{tenant}/rfid/response
RFID_MQTT_MODE_TOPIC_TEMPLATE=edusmart/{tenant}/rfid/mode
RFID_MQTT_DEFAULT_TENANT_SLUG=
RFID_MQTT_DEVICE_TENANT_MAP={}
RFID_MQTT_MODE_SYNC_INTERVAL=20
RFID_MQTT_RECONNECT_DELAY=5

# Session/CORS/Sanctum
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=edusmart.example.com,.edusmart.example.com
CORS_ALLOWED_ORIGINS=https://edusmart.example.com
CORS_ALLOWED_ORIGIN_PATTERNS=#^https://([a-z0-9-]+\\.)?edusmart\\.example\\.com$#
API_RATE_LIMIT_PER_MINUTE=300
DB_RATE_LIMIT_PER_MINUTE=1200
DB_GUEST_RATE_LIMIT_PER_MINUTE=360
STORAGE_WRITE_RATE_LIMIT_PER_MINUTE=90
STORAGE_READ_RATE_LIMIT_PER_MINUTE=180
STORAGE_GUEST_RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=12
AUTH_IP_RATE_LIMIT_PER_MINUTE=90
AUTH_LOGIN_MAX_ATTEMPTS=5

# Multi-tenant
TENANT_ROOT_DOMAIN=edusmart.example.com
TENANT_DEFAULT_SLUG=default
TENANT_ADMIN_SUBDOMAIN=admin
TENANT_ADMIN_HOSTS=
TENANT_ALLOW_ROOT_FOR_SUPER_ADMIN=false
TENANT_ALLOW_HEADER_OVERRIDE=false
TENANT_RESERVED=www,app,api,admin
TENANT_PUBLIC_SCHEME=https
TENANT_DNS_A_RECORD=
TENANT_DNS_CNAME_TARGET=app.edusmart.example.com

# Super admin bootstrap
SUPER_ADMIN_EMAILS=admin@edusmart.example.com
SUPER_ADMIN_IDS=

# First boot behavior
RUN_MIGRATIONS=true
