# Copy to an out-of-repository secret file on the staging host. Never commit values.
COMPOSE_PROJECT_NAME=edusmart_staging_example
RELEASE_SHA=0000000000000000000000000000000000000000
EDUSMART_BACKEND_IMAGE=ghcr.io/example/backend:0000000000000000000000000000000000000000
EDUSMART_NGINX_IMAGE=ghcr.io/example/nginx:0000000000000000000000000000000000000000
EDUSMART_CADDY_IMAGE=ghcr.io/example/caddy:0000000000000000000000000000000000000000
STAGING_POSTGRES_IMAGE=postgres:16.9-alpine
STAGING_REDIS_IMAGE=redis:7.4.2-alpine
STAGING_MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
STAGING_MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z

STAGING_FRONTEND_HOST=staging.example.invalid
STAGING_BACKEND_HOST=api-staging.example.invalid
STAGING_STORAGE_HOST=storage-staging.example.invalid
STAGING_TENANT_ROOT_DOMAIN=staging.example.invalid
STAGING_DEFAULT_TENANT_SLUG=tenant-a
STAGING_ACME_EMAIL=staging-ops@example.invalid
STAGING_SESSION_DOMAIN=

APP_KEY=replace-with-staging-only-secret
DB_DATABASE=edusmart_staging
DB_USERNAME=edusmart_staging
DB_PASSWORD=replace-with-staging-only-secret
REDIS_PASSWORD=replace-with-staging-only-secret
REDIS_PREFIX=edusmart:staging:example:
CACHE_PREFIX=edusmart:staging:example:cache:
HORIZON_PREFIX=edusmart:staging:example:horizon:
TENANT_EDGE_PROXY_SECRET=replace-with-staging-only-secret
STAGING_TEST_PASSWORD=replace-with-staging-only-secret

STAGING_STORAGE_ACCESS_KEY=replace-with-staging-only-secret
STAGING_STORAGE_SECRET_KEY=replace-with-staging-only-secret
STAGING_STORAGE_BUCKET=edusmart-staging-example
STAGING_STORAGE_REGION=us-east-1
STAGING_STORAGE_RETENTION_DAYS=14

API_V2_UPLOADS_ENABLED=false
VITE_USE_ASSIGNMENTS_API_V2=false
VITE_USE_ASSIGNMENT_UPLOADS_API_V2=false
