APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

# Legacy generic DB gateway. Keep true until the API V2 migration and runtime
# observation gate both report zero active consumers.
API_DB_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=edusmart
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
API_V2_UPLOADS_ENABLED=false
API_V2_UPLOAD_PROVIDER=s3-compatible
API_V2_UPLOAD_LOGICAL_BUCKET=assignments
API_V2_UPLOAD_SESSION_TTL_MINUTES=15
API_V2_ATTACHMENT_DOWNLOAD_TTL_SECONDS=600
API_V2_DETACHED_ATTACHMENT_CLEANUP_HOURS=24
API_V2_IDEMPOTENCY_TTL_SECONDS=86400
API_V2_IDEMPOTENCY_LOCK_SECONDS=15
API_V2_IDEMPOTENCY_UPLOAD_LOCK_SECONDS=60
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Backup Google Drive berjalan via queue supaya tombol tidak menunggu proses berat.
BACKUP_QUEUE=backup
BACKUP_SIGNING_KEY=
BACKUP_SIGNING_KEY_ID=primary
BACKUP_JOB_STATUS_TTL_HOURS=24
BACKUP_JOB_TIMEOUT_SECONDS=900
BACKUP_MONTHLY_STATUS_CACHE_TTL_SECONDS=60
BACKUP_MONTHLY_AUTO_START_TIME=21:30
BACKUP_MONTHLY_AUTO_TENANT_SPACING_MINUTES=4
BACKUP_MONTHLY_ACTIVE_JOB_LOCK_MINUTES=45
BACKUP_NOTIFY_EMAIL_ENABLED=false
BACKUP_NOTIFY_SUPER_ADMIN=true
BACKUP_NOTIFY_ON_SUCCESS=false
BACKUP_NOTIFY_ON_FAILURE=true
BACKUP_NOTIFY_ON_DRIVE_ATTENTION=true

# Quiz scalability. Aktifkan async scoring hanya jika queue worker sehat.
QUIZ_CONTENT_CACHE_ENABLED=true
QUIZ_CONTENT_CACHE_TTL_SECONDS=300
QUIZ_ASYNC_SCORING_ENABLED=false
QUIZ_SCORING_QUEUE=quiz-scoring
QUEUE_WORKER_PROCESSES=2
QUIZ_SCORING_WORKER_PROCESSES=4
QUIZ_WORKER_HEARTBEAT_MAX_AGE_SECONDS=150
QUIZ_MONITOR_WARNING_QUEUE_SIZE=100
QUIZ_MONITOR_CRITICAL_QUEUE_SIZE=500
HORIZON_NAME="EduSmart Queue"
HORIZON_PATH=horizon
HORIZON_MEMORY_LIMIT_MB=128
HORIZON_MONITORED_QUEUES=default,backup,quiz-scoring

# RFID high-volume scan tuning.
RFID_TENANT_CACHE_TTL_SECONDS=300
RFID_DEVICE_CACHE_TTL_SECONDS=60
RFID_DEVICE_AUTH_CACHE_TTL_SECONDS=300
RFID_DEVICE_SEEN_THROTTLE_SECONDS=30
RFID_ALWAYS_ACTIVE_CACHE_TTL_SECONDS=600
RFID_SYNC_BATCH_MAX_EVENTS=500
RFID_MQTT_MODE_PUBLISH_AFTER_SCAN_THROTTLE_SECONDS=5
RFID_MQTT_MAX_PAYLOAD_BYTES=8192
RFID_LIVE_EVENTS_REDIS_ENABLED=false
RFID_LIVE_EVENTS_REDIS_CONNECTION=default
RFID_LIVE_EVENTS_STREAM_PREFIX=rfid:live
RFID_LIVE_EVENTS_STREAM_MAX_LENGTH=1000
RFID_LIVE_EVENTS_STREAM_TTL_SECONDS=86400
RFID_LIVE_EVENTS_READ_BLOCK_MS=1000
RFID_LIVE_EVENTS_DB_CATCHUP_SECONDS=5
RFID_DEVICE_EVENT_LOG_ENABLED=true
RFID_DEVICE_EVENT_CACHE_TTL_SECONDS=3600

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-login
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (Login / Link Account)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Daftarkan URL ini sebagai Authorized redirect URI di Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_AUTH_PROMPT=select_account
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/admin/google-drive/callback
GOOGLE_DRIVE_FOLDER_NAME="EduSmart Presensi"
GOOGLE_DRIVE_SHARE_UPLOADED_FILES=true
GOOGLE_DRIVE_USAGE_TIMEZONE=Asia/Jakarta

EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_API_INTEGRATION=WHATSAPP-BAILEYS
EVOLUTION_API_INSTANCE_PREFIX=edusmart
EVOLUTION_API_WEBHOOK_BASE_URL=http://localhost:8000
EVOLUTION_API_TIMEOUT_SECONDS=20
EVOLUTION_API_VERIFY_SSL=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_SESSION_TOKEN=

# Upload file skala besar: aktifkan jika bucket S3/R2/MinIO sudah siap CORS PUT/GET.
APP_OBJECT_STORAGE_ENABLED=false
APP_DIRECT_UPLOAD_ENABLED=false
APP_DIRECT_UPLOAD_BROWSER_ENABLED=false
APP_DIRECT_UPLOAD_BUCKETS=assignments,quiz-media,certificates,sertifikat-files,certificate-templates,sertifikat-templates
APP_OBJECT_STORAGE_LABEL="Nevaobjects S3"
APP_OBJECT_STORAGE_ACCESS_KEY_ID=
APP_OBJECT_STORAGE_SECRET_ACCESS_KEY=
APP_OBJECT_STORAGE_SESSION_TOKEN=
APP_OBJECT_STORAGE_REGION=us-east-1
APP_OBJECT_STORAGE_BUCKET=
APP_OBJECT_STORAGE_ENDPOINT=https://s3.nevaobjects.id
APP_OBJECT_STORAGE_USE_PATH_STYLE_ENDPOINT=true
APP_OBJECT_STORAGE_CAPACITY_GB=
APP_DIRECT_UPLOAD_EXPIRES_SECONDS=900
APP_DIRECT_UPLOAD_VERIFY_OBJECTS=true
APP_DIRECT_UPLOAD_VERIFY_ATTEMPTS=2
APP_DIRECT_UPLOAD_VERIFY_RETRY_MS=150
APP_OBJECT_STORAGE_BUCKET_ASSIGNMENTS=assignments
APP_OBJECT_STORAGE_BUCKET_QUIZ_MEDIA=quiz-media
APP_OBJECT_STORAGE_BUCKET_CERTIFICATES=certificates
APP_OBJECT_STORAGE_BUCKET_SERTIFIKAT_FILES=sertifikat-files
APP_OBJECT_STORAGE_BUCKET_CERTIFICATE_TEMPLATES=certificate-templates
APP_OBJECT_STORAGE_BUCKET_SERTIFIKAT_TEMPLATES=sertifikat-templates

# Legacy env untuk upload tugas lama. Tetap didukung agar deploy existing tidak rusak.
ASSIGNMENT_DIRECT_UPLOAD_ENABLED=false
ASSIGNMENT_OBJECT_STORAGE_LABEL="Object Storage"
ASSIGNMENT_OBJECT_STORAGE_ACCESS_KEY_ID=
ASSIGNMENT_OBJECT_STORAGE_SECRET_ACCESS_KEY=
ASSIGNMENT_OBJECT_STORAGE_SESSION_TOKEN=
ASSIGNMENT_OBJECT_STORAGE_REGION=us-east-1
ASSIGNMENT_OBJECT_STORAGE_BUCKET=
ASSIGNMENT_OBJECT_STORAGE_ENDPOINT=
ASSIGNMENT_OBJECT_STORAGE_USE_PATH_STYLE_ENDPOINT=true
ASSIGNMENT_DIRECT_UPLOAD_EXPIRES_SECONDS=900

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8088,127.0.0.1,127.0.0.1:5173,127.0.0.1:8088,admin.localhost:8088,*.localhost,*.localhost:5173,*.localhost:8088
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGIN_PATTERNS=#^https?://([a-z0-9-]+\\.)?localhost(:\\d+)?$#, #^https?://127\\.0\\.0\\.1(:\\d+)?$#
API_RATE_LIMIT_PER_MINUTE=300
PUBLIC_DIRECTORY_RATE_LIMIT_PER_MINUTE=60
DB_RATE_LIMIT_PER_MINUTE=300
API_DB_ALLOWED_CONSUMERS=legacy-supabase-adapter,admin-class-page
AUTH_RATE_LIMIT_PER_MINUTE=12
AUTH_IP_RATE_LIMIT_PER_MINUTE=90
AUTH_LOGIN_MAX_ATTEMPTS=5
SECURITY_SCANNER_BLOCK_ENABLED=true
SECURITY_SCANNER_BLOCK_AUDIT=true
SECURITY_BLOCKED_IPS=
SECURITY_BLOCKED_USER_AGENTS=sqlmap,nikto,acunetix,nessus,nuclei,zgrab,masscan,dirbuster,gobuster,ffuf,wpscan
RFID_SCAN_SHARED_KEY=
RFID_MQTT_BRIDGE_ENABLED=false
RFID_MQTT_HOST=
RFID_MQTT_PORT=8883
RFID_MQTT_USERNAME=
RFID_MQTT_PASSWORD=
RFID_MQTT_CLIENT_ID_PREFIX=edusmart-rfid-bridge
RFID_MQTT_QOS=1
RFID_MQTT_USE_TLS=true
RFID_MQTT_TLS_VERIFY_PEER=true
RFID_MQTT_TLS_VERIFY_PEER_NAME=true
RFID_MQTT_TLS_ALLOW_SELF_SIGNED=false
RFID_REQUIRE_IDEMPOTENCY_KEY=true
RFID_DEVICE_STATUS_ONLINE_GRACE_SECONDS=120
RFID_MQTT_SCAN_TOPIC_TEMPLATE=edusmart/{tenant}/rfid/{device}/scan
RFID_MQTT_SCAN_TOPIC_FILTER=
RFID_MQTT_RESPONSE_TOPIC_TEMPLATE=edusmart/{tenant}/rfid/{device}/response
RFID_MQTT_MODE_TOPIC_TEMPLATE=edusmart/{tenant}/rfid/{device}/mode
RFID_MQTT_DEFAULT_TENANT_SLUG=
RFID_MQTT_DEVICE_TENANT_MAP={}
RFID_MQTT_MODE_SYNC_INTERVAL=20
RFID_MQTT_RECONNECT_DELAY=5
RFID_MQTT_AUTO_RECONNECT_MAX_ATTEMPTS=5
RFID_MQTT_AUTO_RECONNECT_DELAY_MS=500
RFID_MQTT_CONFIG_RELOAD_INTERVAL=60
RFID_MOSQUITTO_ENABLED=true
RFID_MOSQUITTO_PUBLIC_HOST=mqtt.sismu.biz.id
RFID_MOSQUITTO_PUBLIC_PORT=8883
RFID_MOSQUITTO_PUBLIC_USE_TLS=true
RFID_MOSQUITTO_INTERNAL_HOST=mosquitto
RFID_MOSQUITTO_INTERNAL_PORT=1883
RFID_MOSQUITTO_INTERNAL_USE_TLS=false
RFID_MOSQUITTO_BRIDGE_USERNAME=edusmart_bridge
RFID_MOSQUITTO_BRIDGE_PASSWORD=
RFID_MOSQUITTO_TENANT_USERNAME_PREFIX=edusmart
RFID_MOSQUITTO_TOPIC_PREFIX=edusmart
RFID_MOSQUITTO_STRICT_DEVICE_ACL=true

TENANT_ROOT_DOMAIN=edusmart.myid
TENANT_DEFAULT_SLUG=default
TENANT_ADMIN_SUBDOMAIN=admin
TENANT_ADMIN_HOSTS=
TENANT_ALLOW_ROOT_FOR_SUPER_ADMIN=false
TENANT_RESERVED=www,app,api,admin
TENANT_PUBLIC_SCHEME=https
TENANT_DNS_A_RECORD=
TENANT_DNS_CNAME_TARGET=
CADDY_ASK_SECRET=
CADDY_EVOLUTION_HOST=
SUPER_ADMIN_EMAILS=admin@edusmart.myid
SUPER_ADMIN_IDS=

VITE_APP_NAME="${APP_NAME}"
VITE_DIRECT_UPLOAD_SMALL_FILE_RELAY_BYTES=1048576
VITE_DIRECT_UPLOAD_OBJECT_TIMEOUT_MS=120000
APP_RELEASE_SHA=unknown
API_SLOW_REQUEST_THRESHOLD_MS=1000
OBSERVABILITY_LOG_CHANNEL=structured
OBSERVABILITY_LOG_PATH=/var/www/html/backend/storage/logs/structured.log
FRONTEND_LOG_RETENTION_DAYS=30
