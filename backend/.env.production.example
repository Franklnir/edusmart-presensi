APP_NAME=EduSmart
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://edusmart.example.com
FRONTEND_URL=https://edusmart.example.com
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=edusmart
DB_USERNAME=edusmart
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.edusmart.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_FROM_ADDRESS=franklnlynirsyad@gmail.com
MAIL_FROM_NAME="EduSmart"

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://edusmart.example.com/api/auth/google/callback
GOOGLE_AUTH_PROMPT=select_account

EVOLUTION_API_BASE_URL=https://evolution.edusmart.example.com
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_API_KEY
EVOLUTION_API_INTEGRATION=WHATSAPP-BAILEYS
EVOLUTION_API_INSTANCE_PREFIX=edusmart
EVOLUTION_API_WEBHOOK_BASE_URL=https://edusmart.example.com
EVOLUTION_API_TIMEOUT_SECONDS=20
EVOLUTION_API_VERIFY_SSL=true

SANCTUM_STATEFUL_DOMAINS=edusmart.example.com,.edusmart.example.com
CORS_ALLOWED_ORIGINS=https://edusmart.example.com
CORS_ALLOWED_ORIGIN_PATTERNS=#^https://([a-z0-9-]+\\.)?edusmart\\.example\\.com$#
API_RATE_LIMIT_PER_MINUTE=300
DB_RATE_LIMIT_PER_MINUTE=300
STORAGE_WRITE_RATE_LIMIT_PER_MINUTE=90
STORAGE_READ_RATE_LIMIT_PER_MINUTE=180
STORAGE_GUEST_RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=12
AUTH_IP_RATE_LIMIT_PER_MINUTE=90
AUTH_LOGIN_MAX_ATTEMPTS=5
RFID_SCAN_SHARED_KEY=CHANGE_ME_RFID_SHARED_KEY
RFID_MQTT_BRIDGE_ENABLED=true
RFID_MQTT_HOST=YOUR_HIVEMQ_HOST
RFID_MQTT_PORT=8883
RFID_MQTT_USERNAME=YOUR_HIVEMQ_USERNAME
RFID_MQTT_PASSWORD=YOUR_HIVEMQ_PASSWORD
RFID_MQTT_CLIENT_ID_PREFIX=edusmart-rfid-bridge
RFID_MQTT_QOS=1
RFID_MQTT_USE_TLS=true
RFID_MQTT_TLS_VERIFY_PEER=true
RFID_MQTT_TLS_VERIFY_PEER_NAME=true
RFID_MQTT_TLS_ALLOW_SELF_SIGNED=false
RFID_MQTT_SCAN_TOPIC_TEMPLATE=edusmart/{tenant}/rfid/scan
RFID_MQTT_SCAN_TOPIC_FILTER=
RFID_MQTT_RESPONSE_TOPIC_TEMPLATE=edusmart/{tenant}/rfid/response
RFID_MQTT_MODE_TOPIC_TEMPLATE=edusmart/{tenant}/rfid/mode
RFID_MQTT_DEFAULT_TENANT_SLUG=
RFID_MQTT_DEVICE_TENANT_MAP={}
RFID_MQTT_MODE_SYNC_INTERVAL=20
RFID_MQTT_RECONNECT_DELAY=5

TENANT_ROOT_DOMAIN=edusmart.example.com
TENANT_DEFAULT_SLUG=default
TENANT_ADMIN_SUBDOMAIN=admin
TENANT_ADMIN_HOSTS=
TENANT_ALLOW_ROOT_FOR_SUPER_ADMIN=false
TENANT_ALLOW_HEADER_OVERRIDE=false
TENANT_RESERVED=www,app,api,admin
TENANT_PUBLIC_SCHEME=https
TENANT_DNS_A_RECORD=
TENANT_DNS_CNAME_TARGET=app.edusmart.example.com
CADDY_ASK_SECRET=CHANGE_ME_CADDY_ASK_SECRET
CADDY_EVOLUTION_HOST=wa.edusmart.example.com

SUPER_ADMIN_EMAILS=admin@edusmart.example.com
SUPER_ADMIN_IDS=

VITE_APP_NAME="EduSmart"
