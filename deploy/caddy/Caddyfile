{
	email {$CADDY_ACME_EMAIL}
	admin off
	storage file_system /data/caddy

	on_demand_tls {
		ask http://nginx/api/internal/tls/authorize?secret={$CADDY_ASK_SECRET}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}

localhost, admin.localhost, admin26.localhost, demo.localhost, bali.localhost {
	tls internal

	encode zstd gzip
	reverse_proxy nginx:80
}

wa.localhost {
	tls internal

	encode zstd gzip
	reverse_proxy evolution_api:8080 {
		header_up Origin "https://{host}"
	}
}

{$CADDY_EVOLUTION_HOST} {
	tls {
		on_demand
	}

	import security_headers
	encode zstd gzip
	reverse_proxy evolution_api:8080 {
		header_up Origin "https://{host}"
	}
}

:80 {
	redir https://{host}{$CADDY_HTTPS_PORT_SUFFIX}{uri} 308
}

:443 {
	tls {
		on_demand
	}

	import security_headers
	encode zstd gzip
	reverse_proxy nginx:80
}
