FROM node:20.19.0-alpine AS frontend-build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY . .

ARG VITE_API_URL=
ARG VITE_APP_RELEASE_SHA=
ARG VITE_TENANT_SLUG=
ARG VITE_ROOT_DOMAIN=
ARG VITE_ADMIN_SUBDOMAIN=admin26
ARG VITE_REALTIME_POLL_MS=4000
ARG VITE_REALTIME_POLL_HIDDEN_MS=12000
ARG VITE_GOOGLE_AUTH_ENABLED=false
ARG VITE_GOOGLE_CLIENT_ID=
ARG VITE_GOOGLE_AUTH_LOGIN_URL=/api/auth/google/redirect
ARG VITE_GOOGLE_AUTH_LINK_URL=/api/auth/google/link
ARG VITE_USE_ASSIGNMENTS_API_V2=false
ARG VITE_USE_ASSIGNMENT_UPLOADS_API_V2=false
ARG VITE_USE_SCHEDULES_API_V2=false
ARG VITE_USE_CLASSES_API_V2=false
ARG VITE_USE_ATTENDANCE_API_V2=false
ARG VITE_USE_ANNOUNCEMENTS_API_V2=false
ARG VITE_USE_EXTRACURRICULAR_API_V2=false
ARG VITE_USE_GRADES_API_V2=false
ARG VITE_USE_REPORT_CARDS_API_V2=false

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_APP_RELEASE_SHA=${VITE_APP_RELEASE_SHA}
ENV VITE_TENANT_SLUG=${VITE_TENANT_SLUG}
ENV VITE_ROOT_DOMAIN=${VITE_ROOT_DOMAIN}
ENV VITE_ADMIN_SUBDOMAIN=${VITE_ADMIN_SUBDOMAIN}
ENV VITE_REALTIME_POLL_MS=${VITE_REALTIME_POLL_MS}
ENV VITE_REALTIME_POLL_HIDDEN_MS=${VITE_REALTIME_POLL_HIDDEN_MS}
ENV VITE_GOOGLE_AUTH_ENABLED=${VITE_GOOGLE_AUTH_ENABLED}
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}
ENV VITE_GOOGLE_AUTH_LOGIN_URL=${VITE_GOOGLE_AUTH_LOGIN_URL}
ENV VITE_GOOGLE_AUTH_LINK_URL=${VITE_GOOGLE_AUTH_LINK_URL}
ENV VITE_USE_ASSIGNMENTS_API_V2=${VITE_USE_ASSIGNMENTS_API_V2}
ENV VITE_USE_ASSIGNMENT_UPLOADS_API_V2=${VITE_USE_ASSIGNMENT_UPLOADS_API_V2}
ENV VITE_USE_SCHEDULES_API_V2=${VITE_USE_SCHEDULES_API_V2}
ENV VITE_USE_CLASSES_API_V2=${VITE_USE_CLASSES_API_V2}
ENV VITE_USE_ATTENDANCE_API_V2=${VITE_USE_ATTENDANCE_API_V2}
ENV VITE_USE_ANNOUNCEMENTS_API_V2=${VITE_USE_ANNOUNCEMENTS_API_V2}
ENV VITE_USE_EXTRACURRICULAR_API_V2=${VITE_USE_EXTRACURRICULAR_API_V2}
ENV VITE_USE_GRADES_API_V2=${VITE_USE_GRADES_API_V2}
ENV VITE_USE_REPORT_CARDS_API_V2=${VITE_USE_REPORT_CARDS_API_V2}
ENV NODE_OPTIONS=--max-old-space-size=4096

RUN npm run build

FROM nginx:1.27-alpine

WORKDIR /var/www/html

COPY deploy/nginx/gateway.prod.conf /etc/nginx/conf.d/default.conf
COPY backend/public /var/www/html/public
COPY --from=frontend-build /app/dist /var/www/html/public

EXPOSE 80
