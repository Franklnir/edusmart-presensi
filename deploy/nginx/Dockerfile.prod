FROM node:20.19.0-alpine AS frontend-build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=
ARG VITE_TENANT_SLUG=
ARG VITE_ROOT_DOMAIN=
ARG VITE_ADMIN_SUBDOMAIN=admin
ARG VITE_REALTIME_POLL_MS=4000
ARG VITE_REALTIME_POLL_HIDDEN_MS=12000
ARG VITE_GOOGLE_AUTH_ENABLED=false
ARG VITE_GOOGLE_AUTH_LOGIN_URL=/api/auth/google/redirect
ARG VITE_GOOGLE_AUTH_LINK_URL=/api/auth/google/link

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_TENANT_SLUG=${VITE_TENANT_SLUG}
ENV VITE_ROOT_DOMAIN=${VITE_ROOT_DOMAIN}
ENV VITE_ADMIN_SUBDOMAIN=${VITE_ADMIN_SUBDOMAIN}
ENV VITE_REALTIME_POLL_MS=${VITE_REALTIME_POLL_MS}
ENV VITE_REALTIME_POLL_HIDDEN_MS=${VITE_REALTIME_POLL_HIDDEN_MS}
ENV VITE_GOOGLE_AUTH_ENABLED=${VITE_GOOGLE_AUTH_ENABLED}
ENV VITE_GOOGLE_AUTH_LOGIN_URL=${VITE_GOOGLE_AUTH_LOGIN_URL}
ENV VITE_GOOGLE_AUTH_LINK_URL=${VITE_GOOGLE_AUTH_LINK_URL}

RUN npm run build

FROM nginx:1.27-alpine

WORKDIR /var/www/html

COPY deploy/nginx/gateway.prod.conf /etc/nginx/conf.d/default.conf
COPY backend/public /var/www/html/public
COPY --from=frontend-build /app/dist /var/www/html/public

EXPOSE 80
