# Ganti domain, path, dan sertifikat sesuai server kamu

server {
    listen 80;
    server_name sismu.biz.id admin26.sismu.biz.id sman3bogor.sismu.biz.id;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name sismu.biz.id admin26.sismu.biz.id sman3bogor.sismu.biz.id;

    # Frontend React hasil build (npm run build)
    root /var/www/edusmart/dist;
    index index.html;

    # SSL Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/sismu.biz.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sismu.biz.id/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 25m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Backend Laravel dari supervisor (php artisan serve --host=127.0.0.1 --port=8000)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /sanctum/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
