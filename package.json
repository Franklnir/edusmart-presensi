{
  "name": "edusmart-rtdb-supabase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "lint": "eslint .",
    "lint:legacy": "node scripts/check-legacy-consumers.mjs",
    "test": "vitest run",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "check": "npm run build",
    "security:env": "bash scripts/security/check-env-secrets.sh",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:full": "npm audit",
    "audit:api-db-legacy": "node scripts/audit-api-db-legacy.mjs",
    "audit:schedules-v2": "node scripts/audit-schedules-v2.mjs",
    "audit:staging-flags": "node scripts/check-staging-flags.mjs",
    "smoke:public": "node scripts/smoke/public-site-smoke.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.554.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^6.30.4",
    "react-to-print": "^3.2.0",
    "react-window": "^2.2.7",
    "swiper": "^12.1.2",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "terser": "^5.44.1",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "3.4.11"
  }
}
